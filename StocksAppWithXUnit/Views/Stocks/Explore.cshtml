@model List<Stock>
@{
    ViewBag.Title = "Explore";
}

<nav class="navbar">
    <ul>
        <li><a asp-controller="Stocks" asp-action="Explore" class="nav-active">Explore</a></li>
        <li><a asp-controller="Trade" asp-action="Index">Trade</a></li>
        <li><a asp-controller="Trade" asp-action="Orders">Orders</a></li>
    </ul>
</nav>

<div class="text-grey ml">
    Stocks <i class="fa-solid fa-caret-right"></i> Explore
</div>

<div class="flex stocks-list">
    <div class="flex-1" id="stocks-list">

        <div class="box">
            <div class="flex">
                <div class="flex-1">
                    <h4 class="text-grey mb">Stocks</h4>
                </div>
                <div class="flex-1 text-right">
                    <a href="~/Stocks/Explore?showAll=true" class="mr">Show all stocks</a>
                </div>
            </div>
            <ul class="list">
                @foreach (Stock stock in Model)
                {
                    <li>
                        @if (Context.Request.Query.ContainsKey("showAll"))
                        {
                            <a href="~/Stocks/Explore?stock=@stock.StockSymbol&showAll=@Context.Request.Query["showAll"]">
                                <h4>@stock.StockName</h4>
                                <div class="text-grey">(@stock.StockSymbol)</div>
                            </a>
                        }
                        else
                        {
                            <a asp-action="Explore" asp-controller="Stocks" asp-route-stock="@stock.StockSymbol">
                                <h4>@stock.StockName</h4>
                                <span class="text-grey">(@stock.StockSymbol)</span>
                            </a>
                        }
                    </li>
                }
            </ul>
            @if (Model.Count == 0)
            {
                <div class="mt text-blue">No stocks</div>
            }
        </div>
    </div>
    <div class="flex-1" id="stock-details">
        @if (ViewBag.Stock != null)
        {
            @await Component.InvokeAsync("SelectedStock", new { stockSymbol = ViewBag.Stock })
        }
    </div>
</div>

