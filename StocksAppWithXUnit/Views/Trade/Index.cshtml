@model StockTrade
@{
    ViewBag.Title = "Trade";
}

<nav class="navbar">
    <ul>
        <li><a asp-controller="Trade" asp-action="Index" class="nav-active">Trade</a></li>
        <li><a asp-controller="Trade" asp-action="Orders">Orders</a></li>
    </ul>
</nav>

<div class="text-grey ml">
    Stocks <i class="fa-solid fa-caret-right"></i> @Model.StockName
</div>

<form method="post">
    <div class="box trading-panel">
        <div class="flex trading-panel-flex">
            <div id="stock-price-panel">
                <div class="stock">
                    <h3 class="stock-title">@Model.StockName (@Model.StockSymbol)</h3>
                    <div class="stock-price"><span class="text-grey">$</span> <span class="price">@Model.Price</span></div>
                </div>
            </div>
            <div id="new-order-panel">
                <div class="flex flex-direction-vertical">
                    <h3 class="text-grey mb">New Order</h3>
                    <label asp-for="Quantity" class="mt">Quantity:</label>
                    <div class="w-25">
                        <input type="number" asp-for="Quantity" class="form-input mb" autofocus="autofocus" />
                        <span asp-validation-for="Quantity" class="text-red"></span>
                    </div>
                </div>
                <div class="button-panel">
                    <button type="submit" formaction="~/Trade/SellOrder" class="button button-red-back trading-button sell-button"><i class="fa-solid fa-down-long" style="color: #ffffff;"></i>Sell</button>
                    <button type="submit" formaction="~/Trade/BuyOrder" class="button button-green-back trading-button buy-button"><i class="fa-solid fa-up-long" style="color: #ffffff;"></i>Buy</button>
                    @if (ViewBag.Errors != null)
                    {
                        <div class="text-red mt">
                            <ul>
                                @foreach (string error in ViewBag.Errors)
                                {
                                    <li class="ml">@error</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <input id="hiddenStockSymbol" asp-for="StockSymbol" hidden />
    <input id="hiddenStockName" asp-for="StockName" hidden />
    <input id="hiddenStockPrice" asp-for="Price" hidden />
    <input id="hiddenFinnhubToken" name="FinnhubToken" value="@ViewBag.FinnhubToken" hidden />

</form>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" asp-fallback-src="~/jquery.min.js" asp-fallback-test="window.jQuery"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js" asp-fallback-src="~/jquery.validate.min.js" asp-fallback-test="window.jQuery.validator"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" asp-fallback-src="~/jquery.validate.unobtrusive.min.js" asp-fallback-test="window.jQuery.validator.unobtrusive"></script>
    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/script/FinnhubScript.js"></script>
}