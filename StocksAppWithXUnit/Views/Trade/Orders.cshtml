@model Orders
@{
    ViewBag.Title = "Orders";
}

<nav class="navbar">
    <ul>
        <li><a asp-controller="Trade" asp-action="Index">Trade</a></li>
        <li><a asp-controller="Trade" asp-action="Orders" class="nav-active">Orders</a></li>
    </ul>
</nav>

<div class="text-grey ml">
    <div class="float-left">Stocks <i class="fa-solid fa-caret-right"></i> Orders</div>
    <div class="text-right">
        <a asp-action="OrdersPDF" asp-controller="Trade">Download as PDF</a>
    </div>
</div>

<div class="flex orders-list">
    <div id="buy-orders-list">
        <div class="box">
            <h3 class="text-grey mb">Buy Orders</h3>
            <div class="">
                @foreach (BuyOrderResponse buyOrderResponse in Model.BuyOrders)
                {
                    @await Html.PartialAsync("_BuyOrdersCard", buyOrderResponse)
                }
            </div>
        </div>
    </div>
    <div id="sell-orders-list">
        <div class="box">
            <h3 class="text-grey m">Sell Orders</h3>
            <div class="">
                @foreach (SellOrderResponse sellOrderResponse in Model.SellOrders)
                {
                    @await Html.PartialAsync("_SellOrdersCard", sellOrderResponse)
                }
            </div>
        </div>
    </div>
</div>