@model SellOrderResponse

<div class="border-bottom p">
    <h3>@Model.StockName (@Model.StockSymbol)</h3>
    <h5 class="mb">@Model.Quantity <span class="text-grey">shares at </span>@Model.Price.ToString("N")</h5>
    <h5 class="mb"> <span class="text-grey">Trade Amount:</span>$@Model.TradeAmount.ToString("N")</h5>
    <div class="text-grey">
        @Model.DateAndTimeOfOrder?.ToString("dd MMM yyyy hh:mm tt")
    </div>
</div>