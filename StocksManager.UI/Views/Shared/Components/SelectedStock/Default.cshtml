@model SelectedStockModel

@{
    Layout = null;
}

<div>
    <img src="@Model.Logo" width="200" />
    <h1 class="">@Model.StockName (@Model.StockSymbol)</h1>
    <span class="pill">@Model.Industry</span>
    <h3 class="mb">
        <b>Exchange: </b>
        <span class="pill"><b>@Model.Exchange</b></span>
    </h3>
    <h1 class="stock-price"><span class="text-grey">$ </span>@Model.Price</h1>
    <a class="button-link button-blue-back" id="trade-button" asp-action="Index" asp-controller="Trade" asp-route-stockSymbol="@Model.StockSymbol">
        Trade Now
    </a>
</div>