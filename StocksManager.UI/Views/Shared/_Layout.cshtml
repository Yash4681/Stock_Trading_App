<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="page-content">
            <div class="flex w-100 mb">
                <div class="flex-1 app-title">
                    <h1>
                        <i class="fa-solid fa-money-bill-trend-up"></i> Stocks
                    </h1>
                </div>
                <div id="search-box-divs">
                    <input type="search" placeholder="Search Stocks" class="search-text" />
                    <i class="fa-solid fa-gear"></i>
                    <button class="login-button button button-blue-back ml">Login</button>
                </div>
            </div>            
            @RenderBody()
        </div>        
    </div>

    @await RenderSectionAsync("scripts", false);
</body>
</html>
