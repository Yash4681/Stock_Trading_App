@model Orders
@{
    Layout = null;
}

<link href="@("http://" + Context.Request.Host.ToString() + "/StyleSheet.css")" rel="stylesheet" />
<h1>Orders</h1>
<table class="table w-100">
    <thead>
        <tr>
            <th>Date and Time</th>
            <th>Stock</th>
            <th>Order Type</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Trade Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (BuyOrderResponse buyOrder in Model.BuyOrders)
        {
            <tr>
                @if (buyOrder.DateAndTimeOfOrder.HasValue)
                {                    
                    <td>@buyOrder.DateAndTimeOfOrder.Value.ToString("dd MMMM yyyy hh:mm:ss tt")</td>
                }
                <td>@buyOrder.StockName (@buyOrder.StockSymbol)</td>
                <td>BuyOrder</td>
                <td>@buyOrder.Quantity</td>
                <td>$ @buyOrder.Price</td>
                <td>@(buyOrder.Quantity * buyOrder.Price)</td>
            </tr>
        }
        @foreach (SellOrderResponse sellOrder in Model.SellOrders)
        {
            <tr>
                @if (sellOrder.DateAndTimeOfOrder.HasValue)
                {
                    <td>@sellOrder.DateAndTimeOfOrder.Value.ToString("dd MMMM yyyy hh:mm:ss tt")</td>
                }
                <td>@sellOrder.StockName (@sellOrder.StockSymbol)</td>
                <td>SellOrder</td>
                <td>@sellOrder.Quantity</td>
                <td>$ @sellOrder.Price</td>
                <td>@(sellOrder.Quantity * sellOrder.Price)</td>
            </tr>
        }
    </tbody>
</table>